# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your_api_key_here



# Model: auto (Flash vs Pro per item), gemini-3.5-flash, or gemini-3.1-pro-preview

GEMINI_MODEL=auto



# PDF input: auto (extract text when MCQ-like, else vision), text, vision

# ANKI_BOT_PDF_MODE=auto



# Cost savers (optional)

# ANKI_BOT_BULK_QBANK=1

# ANKI_BOT_MAX_IMAGE_SIDE=1600

# ANKI_BOT_CACHE_PROMPTS=1

# ANKI_BOT_ESCALATE_PRO=1



# ANKI_BOT_DECK=HUB::anki-bot

# ANKI_BOT_MAX_CARDS=20

# ANKI_BOT_LECTURE_HOUR_CHARS=18000

# Google Drive mirror (optional; for dual local+Drive skip and sync)
# ANKI_BOT_RCLONE_REMOTE=gdrive
# ANKI_BOT_DRIVE_INPUT=G:\My Drive\anki-bot\input
# ANKI_BOT_DRIVE_OUTPUT=G:\My Drive\anki-bot\output
# Or rclone specs: ANKI_BOT_DRIVE_INPUT=gdrive:anki-bot/input

